# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real .env (it is gitignored).
# ─────────────────────────────────────────────────────────────

# PumpPortal — free real-time new-token + migration stream.
# Get a key at https://pumpportal.fun (link a wallet with >= 0.02 SOL).
# The key is only required for the *trading* API; the free data websocket
# works without it, but linking a key is recommended for reliability.
PUMPPORTAL_API_KEY= 

# Helius — Solana RPC. Free tier: 1M credits/mo, 10 req/s.
# Sign up at https://helius.dev and paste your full RPC URL, e.g.
# https://mainnet.helius-rpc.com/?api-key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HELIUS_RPC_URL= https://mainnet.helius-rpc.com/?api-key=e7b1f599-a245-4a17-8c6b-5f59612cebe4

# RugCheck — aggregated risk report. Free tier with API key.
# Sign up at https://rugcheck.xyz. Leave blank to run without RugCheck
# (its score component is then treated as neutral).
RUGCHECK_API_KEY= https://mainnet.helius-rpc.com/?api-key=e7b1f599-a245-4a17-8c6b-5f59612cebe4

# Telegram — create a bot via @BotFather, then message the bot once and
# grab your chat id (e.g. via https://api.telegram.org/bot<TOKEN>/getUpdates).
TELEGRAM_BOT_TOKEN= 8845913922:AAEOejxWTROkKdXbdEm7qVPHKB8d9NU-RZo
TELEGRAM_CHAT_ID= 7548270963

# Discord — Channel settings -> Integrations -> Webhooks -> New Webhook.
DISCORD_WEBHOOK_URL=