{"ts": "2026-07-19T17:19:37", "level": "DEBUG", "logger": "aiosqlite", "msg": "executing functools.partial(<built-in method executescript of sqlite3.Connection object at 0x000001A5B2EA4130>, '-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\\n--  Solana Memecoin Screener \u2014 SQLite schema\\n--  All bot state lives here so a crash-restart loses nothing.\\n-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\\n\\nPRAGMA journal_mode = WAL;      -- concurrent read while writing\\nPRAGMA foreign_keys = ON;\\n\\n-- One row per token we\\'ve ever seen. `mint` is the Solana mint address.\\nCREATE TABLE IF NOT EXISTS tokens (\\n    mint            TEXT PRIMARY KEY,\\n    symbol          TEXT,\\n    name            TEXT,\\n    pair_address    TEXT,               -- primary DexScreener pair, once known\\n    state           TEXT NOT NULL DEFAULT \\'NEW\\',\\n                                        -- NEW|WATCHING|CANDIDATE|ALERTED|REJECTED|EXPIRED\\n    created_at      REAL NOT NULL,      -- unix ts we first saw it\\n    launch_ts       REAL,              -- best estimate of on-chain launch time\\n    migrated_ts     REAL,              -- pump.fun graduation time, if seen\\n    next_check_ts   REAL NOT NULL DEFAULT 0,   -- scheduler due time\\n    last_check_ts   REAL,\\n    last_score      REAL,\\n    last_alert_score REAL,             -- score at the most recent alert sent\\n    reject_reason   TEXT,\\n    reject_ts       REAL,\\n    recheck_after_ts REAL,             -- for one-shot re-check of concentration rejects\\n    updated_at      REAL NOT NULL\\n);\\n\\nCREATE INDEX IF NOT EXISTS idx_tokens_state       ON tokens(state);\\nCREATE INDEX IF NOT EXISTS idx_tokens_next_check   ON tokens(next_check_ts);\\n\\n-- Every enrichment snapshot, kept for backtesting the scoring model.\\nCREATE TABLE IF NOT EXISTS snapshots (\\n    id              INTEGER PRIMARY KEY AUTOINCREMENT,\\n    mint            TEXT NOT NULL REFERENCES tokens(mint) ON DELETE CASCADE,\\n    ts              REAL NOT NULL,\\n    -- security facts\\n    mint_revoked    INTEGER,\\n    freeze_revoked  INTEGER,\\n    lp_secured      INTEGER,\\n    lp_lock_days    REAL,\\n    top10_pct       REAL,\\n    dev_pct         REAL,\\n    metadata_mutable INTEGER,\\n    bundled_snipers INTEGER,\\n    rugcheck_score  REAL,\\n    rugcheck_label  TEXT,\\n    -- market facts\\n    price_usd       REAL,\\n    liquidity_usd   REAL,\\n    market_cap_usd  REAL,\\n    fdv_usd         REAL,\\n    vol24h_usd      REAL,\\n    vol_liq_ratio   REAL,\\n    buys_1h         INTEGER,\\n    sells_1h        INTEGER,\\n    buys_sells_ratio REAL,\\n    holders         INTEGER,\\n    holder_growth_1h REAL,\\n    price_change_1h REAL,\\n    age_minutes     REAL,\\n    -- social facts\\n    has_socials     INTEGER,\\n    paid_profile    INTEGER,\\n    active_meta     INTEGER,\\n    -- verdict\\n    passed_hard     INTEGER,\\n    score           REAL,\\n    score_security  REAL,\\n    score_traction  REAL,\\n    score_social    REAL,\\n    score_momentum  REAL,\\n    raw_json        TEXT               -- full snapshot for debugging\\n);\\n\\nCREATE INDEX IF NOT EXISTS idx_snapshots_mint ON snapshots(mint, ts);\\n\\n-- One row per alert dispatched.\\nCREATE TABLE IF NOT EXISTS alerts (\\n    id              INTEGER PRIMARY KEY AUTOINCREMENT,\\n    mint            TEXT NOT NULL REFERENCES tokens(mint) ON DELETE CASCADE,\\n    ts              REAL NOT NULL,\\n    score           REAL NOT NULL,\\n    is_followup     INTEGER NOT NULL DEFAULT 0,\\n    reason          TEXT,              -- e.g. \"threshold\" / \"score +18\" / \"LP pulled\"\\n    price_usd       REAL,\\n    market_cap_usd  REAL,\\n    liquidity_usd   REAL,\\n    snapshot_id     INTEGER REFERENCES snapshots(id)\\n);\\n\\nCREATE INDEX IF NOT EXISTS idx_alerts_mint ON alerts(mint, ts);\\n\\n-- Outcome tracking: price at +1h/+6h/+24h after each alert for model tuning.\\nCREATE TABLE IF NOT EXISTS outcomes (\\n    id              INTEGER PRIMARY KEY AUTOINCREMENT,\\n    alert_id        INTEGER NOT NULL REFERENCES alerts(id) ON DELETE CASCADE,\\n    mint            TEXT NOT NULL,\\n    checkpoint_h    INTEGER NOT NULL,  -- 1, 6, 24\\n    due_ts          REAL NOT NULL,\\n    recorded_ts     REAL,\\n    price_usd       REAL,\\n    liquidity_usd   REAL,\\n    multiple        REAL,              -- price / entry price\\n    rugged          INTEGER,           -- 1 if liquidity collapsed\\n    UNIQUE(alert_id, checkpoint_h)\\n);\\n\\nCREATE INDEX IF NOT EXISTS idx_outcomes_due ON outcomes(recorded_ts, due_ts);\\n\\n-- Simple key/value for bot meta (last heartbeat, last daily summary, etc.)\\nCREATE TABLE IF NOT EXISTS kv (\\n    key   TEXT PRIMARY KEY,\\n    value TEXT\\n);\\n')"}
{"ts": "2026-07-19T17:19:37", "level": "DEBUG", "logger": "aiosqlite", "msg": "operation functools.partial(<built-in method executescript of sqlite3.Connection object at 0x000001A5B2EA4130>, '-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\\n--  Solana Memecoin Screener \u2014 SQLite schema\\n--  All bot state lives here so a crash-restart loses nothing.\\n-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\\n\\nPRAGMA journal_mode = WAL;      -- concurrent read while writing\\nPRAGMA foreign_keys = ON;\\n\\n-- One row per token we\\'ve ever seen. `mint` is the Solana mint address.\\nCREATE TABLE IF NOT EXISTS tokens (\\n    mint            TEXT PRIMARY KEY,\\n    symbol          TEXT,\\n    name            TEXT,\\n    pair_address    TEXT,               -- primary DexScreener pair, once known\\n    state           TEXT NOT NULL DEFAULT \\'NEW\\',\\n                                        -- NEW|WATCHING|CANDIDATE|ALERTED|REJECTED|EXPIRED\\n    created_at      REAL NOT NULL,      -- unix ts we first saw it\\n    launch_ts       REAL,              -- best estimate of on-chain launch time\\n    migrated_ts     REAL,              -- pump.fun graduation time, if seen\\n    next_check_ts   REAL NOT NULL DEFAULT 0,   -- scheduler due time\\n    last_check_ts   REAL,\\n    last_score      REAL,\\n    last_alert_score REAL,             -- score at the most recent alert sent\\n    reject_reason   TEXT,\\n    reject_ts       REAL,\\n    recheck_after_ts REAL,             -- for one-shot re-check of concentration rejects\\n    updated_at      REAL NOT NULL\\n);\\n\\nCREATE INDEX IF NOT EXISTS idx_tokens_state       ON tokens(state);\\nCREATE INDEX IF NOT EXISTS idx_tokens_next_check   ON tokens(next_check_ts);\\n\\n-- Every enrichment snapshot, kept for backtesting the scoring model.\\nCREATE TABLE IF NOT EXISTS snapshots (\\n    id              INTEGER PRIMARY KEY AUTOINCREMENT,\\n    mint            TEXT NOT NULL REFERENCES tokens(mint) ON DELETE CASCADE,\\n    ts              REAL NOT NULL,\\n    -- security facts\\n    mint_revoked    INTEGER,\\n    freeze_revoked  INTEGER,\\n    lp_secured      INTEGER,\\n    lp_lock_days    REAL,\\n    top10_pct       REAL,\\n    dev_pct         REAL,\\n    metadata_mutable INTEGER,\\n    bundled_snipers INTEGER,\\n    rugcheck_score  REAL,\\n    rugcheck_label  TEXT,\\n    -- market facts\\n    price_usd       REAL,\\n    liquidity_usd   REAL,\\n    market_cap_usd  REAL,\\n    fdv_usd         REAL,\\n    vol24h_usd      REAL,\\n    vol_liq_ratio   REAL,\\n    buys_1h         INTEGER,\\n    sells_1h        INTEGER,\\n    buys_sells_ratio REAL,\\n    holders         INTEGER,\\n    holder_growth_1h REAL,\\n    price_change_1h REAL,\\n    age_minutes     REAL,\\n    -- social facts\\n    has_socials     INTEGER,\\n    paid_profile    INTEGER,\\n    active_meta     INTEGER,\\n    -- verdict\\n    passed_hard     INTEGER,\\n    score           REAL,\\n    score_security  REAL,\\n    score_traction  REAL,\\n    score_social    REAL,\\n    score_momentum  REAL,\\n    raw_json        TEXT               -- full snapshot for debugging\\n);\\n\\nCREATE INDEX IF NOT EXISTS idx_snapshots_mint ON snapshots(mint, ts);\\n\\n-- One row per alert dispatched.\\nCREATE TABLE IF NOT EXISTS alerts (\\n    id              INTEGER PRIMARY KEY AUTOINCREMENT,\\n    mint            TEXT NOT NULL REFERENCES tokens(mint) ON DELETE CASCADE,\\n    ts              REAL NOT NULL,\\n    score           REAL NOT NULL,\\n    is_followup     INTEGER NOT NULL DEFAULT 0,\\n    reason          TEXT,              -- e.g. \"threshold\" / \"score +18\" / \"LP pulled\"\\n    price_usd       REAL,\\n    market_cap_usd  REAL,\\n    liquidity_usd   REAL,\\n    snapshot_id     INTEGER REFERENCES snapshots(id)\\n);\\n\\nCREATE INDEX IF NOT EXISTS idx_alerts_mint ON alerts(mint, ts);\\n\\n-- Outcome tracking: price at +1h/+6h/+24h after each alert for model tuning.\\nCREATE TABLE IF NOT EXISTS outcomes (\\n    id              INTEGER PRIMARY KEY AUTOINCREMENT,\\n    alert_id        INTEGER NOT NULL REFERENCES alerts(id) ON DELETE CASCADE,\\n    mint            TEXT NOT NULL,\\n    checkpoint_h    INTEGER NOT NULL,  -- 1, 6, 24\\n    due_ts          REAL NOT NULL,\\n    recorded_ts     REAL,\\n    price_usd       REAL,\\n    liquidity_usd   REAL,\\n    multiple        REAL,              -- price / entry price\\n    rugged          INTEGER,           -- 1 if liquidity collapsed\\n    UNIQUE(alert_id, checkpoint_h)\\n);\\n\\nCREATE INDEX IF NOT EXISTS idx_outcomes_due ON outcomes(recorded_ts, due_ts);\\n\\n-- Simple key/value for bot meta (last heartbeat, last daily summary, etc.)\\nCREATE TABLE IF NOT EXISTS kv (\\n    key   TEXT PRIMARY KEY,\\n    value TEXT\\n);\\n') completed"}
